PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/secure_connect
# Use a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h
# Comma-separated emails that receive the admin role at signup (for testing RBAC)
ADMIN_EMAILS=admin@example.com
NODE_ENV=development
